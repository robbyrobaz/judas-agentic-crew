[Unit]
Description=Judas Operator Flow timer — hourly (PM agent cycle)

[Timer]
# Hourly. The Operator's job is to look at live positions, the strategy
# registry, and the delegation queue every hour and decide what to do.
# Session-status gates inside each agent handle market-hours filtering.
OnCalendar=*-*-* *:00:00 UTC
Persistent=false
Unit=judas-operator.service

[Install]
WantedBy=timers.target

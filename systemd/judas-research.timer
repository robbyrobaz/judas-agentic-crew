[Unit]
Description=Judas Research timer — weekend hourly + weekday nightly

[Timer]
# Weekend lab: every hour on Saturday and Sunday, local system time.
OnCalendar=Sat,Sun *:15:00
# Weekday nightly pass: 7:15 PM local system time Monday through Friday.
OnCalendar=Mon..Fri 19:15:00
Persistent=false
Unit=judas-research.service

[Install]
WantedBy=timers.target

[Unit]
Description=Judas Operator Flow timer — every 30 minutes

[Timer]
# Every 30 min. The Operator must stay on top of live positions and the
# delegation queue. Session-status gates filter market-hours.
OnCalendar=*-*-* *:00,30:00 UTC
Persistent=false
Unit=judas-operator.service

[Install]
WantedBy=timers.target

[Unit]
Description=JudasFutures Registrar specialist (Phase 10)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/rob/judas-agentic-crew
EnvironmentFile=/home/rob/judas-agentic-crew/.env
ExecStart=/home/rob/judas-agentic-crew/.venv/bin/python /home/rob/judas-agentic-crew/scripts/run_registrar.py
TimeoutStartSec=10min
KillMode=control-group
StandardOutput=journal
StandardError=journal
